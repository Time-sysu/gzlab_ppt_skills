{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Time-sysu/gzlab_ppt_skills/templates/asset_request.schema.json",
  "title": "asset_request.json — 每页需要什么素材",
  "description": "Per-page asset requirements derived from slide_briefs.json before retrieval. One file per project at <project>/asset_request.json. Auditable project artifact, not a central database.",
  "type": "object",
  "required": ["version", "project", "requests"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "project": { "type": "string" },
    "intended_use": {
      "type": "string",
      "enum": ["内部汇报", "项目申报", "学术交流", "宣传展示", "允许对外"],
      "description": "本次PPT整体用途，映射乐享「允许用途」硬过滤"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/request" }
    }
  },
  "definitions": {
    "request": {
      "type": "object",
      "required": ["page_id", "asset_purpose", "semantic_query", "filters", "max_results"],
      "additionalProperties": false,
      "properties": {
        "page_id": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "asset_purpose": { "type": "string", "description": "图片承担的论证作用，来自 slide_briefs" },
        "semantic_query": { "type": "string", "minLength": 2, "description": "语义检索式（乐享Agent正文检索/候选重排用）" },
        "filters": {
          "type": "object",
          "description": "结构化属性条件；键为乐享自定义属性名，值为选项 label 数组；硬过滤字段由工作流自动注入，不可在此放宽",
          "properties": {
            "所属项目": { "type": "array", "items": { "type": "string" } },
            "内容描述": { "type": "array", "items": { "type": "string" } },
            "素材类型": { "type": "array", "items": { "type": "string" } },
            "场景标签": { "type": "array", "items": { "type": "string" } },
            "PPT用途": { "type": "array", "items": { "type": "string" } },
            "图片方向": { "type": "array", "items": { "type": "string" } },
            "质量等级": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "orientation_hint": { "type": "string", "enum": ["横版", "竖版", "方形", "全景", "不限"], "default": "不限" },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
        "fallback": {
          "type": "string",
          "enum": ["ask_user_ai", "placeholder", "skip"],
          "default": "ask_user_ai",
          "description": "知识库无结果时的策略：ask_user_ai=询问用户是否AI生成；placeholder=占位符人工补充"
        }
      }
    }
  }
}
