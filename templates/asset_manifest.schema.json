{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Time-sysu/gzlab_ppt_skills/templates/asset_manifest.schema.json",
  "title": "asset_manifest.json — 最终选择了哪些素材",
  "description": "Final per-page asset selection after retrieval and user confirmation, at <project>/asset_manifest.json. Executor may only use assets listed here (mirrored into spec_lock.md images).",
  "type": "object",
  "required": ["version", "project", "selections"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "project": { "type": "string" },
    "selections": {
      "type": "array",
      "items": { "$ref": "#/definitions/selection" }
    }
  },
  "definitions": {
    "selection": {
      "type": "object",
      "required": ["page_id", "file", "origin", "status"],
      "additionalProperties": false,
      "properties": {
        "page_id": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "file": { "type": "string", "description": "项目 images/ 内的文件名" },
        "origin": {
          "type": "string",
          "enum": ["user_provided", "lexiang_reviewed", "lexiang_pending_internal", "ai_generated", "placeholder"],
          "description": "lexiang_pending_internal=刚抽取、仅当前内部任务临时使用的待审核素材"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "needs_manual"],
          "description": "needs_manual=知识库无结果且用户未允许AI，占位待人工补充"
        },
        "lexiang_entry_id": { "type": "string", "description": "乐享素材条目ID（origin 为 lexiang_* 时必填）" },
        "crop_rule": { "type": "string", "description": "裁剪/呈现规则，如 16:9 居中裁切" },
        "note": { "type": "string" }
      }
    }
  }
}
